# ---- EvaTeam ----
# Базовый URL вашего инстанса EvaTeam (без завершающего слэша).
# Клиент обращается к {BASE_URL}/api/ (JSON-RPC 2.2).
EVATEAM_BASE_URL=https://evateam.example.ru
# Сервисный API-токен (создаётся у сервис-пользователя в разделе "Безопасность").
# Сервис-пользователь должен быть в группе Admins (для admin_mode — см. ниже).
EVATEAM_TOKEN=replace-me
# Схема заголовка Authorization. Подтверждено: EvaTeam использует "bearer".
# Варианты: "bearer" -> "Authorization: Bearer <token>", "token" -> "Authorization: Token <token>",
#           "header:X-Auth-Token" -> "X-Auth-Token: <token>"
EVATEAM_AUTH_MODE=bearer
# admin_mode=true — сервис-аккаунт (в группе Admins) видит задачи всех сотрудников.
EVATEAM_ADMIN_MODE=true
# Проверка TLS-сертификата. Значения:
#   system  — доверять системному хранилищу ОС (Windows/mac/Linux); подходит для
#             корпоративной сети с прокси/Kaspersky/внутренним CA (рекомендуется)
#   true    — стандартный набор CA (certifi)
#   false   — отключить проверку (только для отладки)
#   <путь>  — путь к своему CA-бандлу (.pem/.cer в формате Base-64)
EVATEAM_VERIFY_SSL=system

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=replace-me

# ---- Прокси (для Telegram и EvaTeam) ----
# Единый прокси для исходящих запросов в корп-сети.
#   пусто  -> взять из окружения (HTTPS_PROXY/HTTP_PROXY)
#   none   -> прямое соединение (без прокси)
#   <url>  -> явный адрес, напр. http://proxy.example.local:1080
PROXY_URL=

# ---- Расписание ----
# Часовой пояс (IANA), напр. Europe/Moscow
TIMEZONE=Europe/Moscow
# Время утреннего дайджеста, HH:MM
DIGEST_TIME=09:00
# Время ежедневной проверки просроченных задач, HH:MM
DEADLINE_CHECK_TIME=09:30
# Вечернее напоминание исполнителям: закрыть выполненное, подвинуть сроки, HH:MM
EVENING_CHECK_TIME=16:00

# ---- Сводка по проектам (/summary) ----
# Коды статусов эпиков (CmfStatus.code), которые попадают в отчёт, через запятую.
# Смотреть текущие статусы: python -m evateam_bot.evateam.smoke --epics
# ВНИМАНИЕ: коды status.code и типы cache_status_type — разные вещи. Например,
# "Пауза"/"Приостановлен" имеют код `pause`, но тип OPEN, и по типу их не отличить
# от "TO DO". Если эпики ещё не переведены в рабочие статусы, отчёт будет пустым —
# добавьте `open`:
#   SUMMARY_EPIC_STATUS_CODES=in_progress,in_review,pause,open
SUMMARY_EPIC_STATUS_CODES=in_progress,in_review,pause
# Коды статусов задач ВНУТРИ эпика. Отдельно от эпиков: расширяя фильтр эпиков
# (например, добавив `open`), не хочется тянуть в отчёт весь бэклог задач.
SUMMARY_TASK_STATUS_CODES=in_progress,in_review,pause
# Сколько дней до планового конца считать «под угрозой» (жёлтый).
SUMMARY_RISK_DAYS=7
# Каталог для сгенерированных HTML/CSV/JSON (внутри data/, не коммитится).
SUMMARY_OUTPUT_DIR=data/reports

# ---- Хранилище ----
DB_PATH=data/bot.db
