# ---- EvaTeam ----
# Базовый URL вашего инстанса EvaTeam (без завершающего слэша).
# Клиент обращается к {BASE_URL}/api/ (JSON-RPC 2.2).
EVATEAM_BASE_URL=https://evateam.example.ru
# Сервисный API-токен (создаётся у сервис-пользователя в разделе "Безопасность").
# Сервис-пользователь должен быть в группе Admins (для admin_mode — см. ниже).
EVATEAM_TOKEN=replace-me
# Схема заголовка Authorization. Подтверждено: EvaTeam использует "bearer".
# Варианты: "bearer" -> "Authorization: Bearer <token>", "token" -> "Authorization: Token <token>",
#           "header:X-Auth-Token" -> "X-Auth-Token: <token>"
EVATEAM_AUTH_MODE=bearer
# admin_mode=true — сервис-аккаунт (в группе Admins) видит задачи всех сотрудников.
EVATEAM_ADMIN_MODE=true
# Проверка TLS-сертификата. Значения:
#   system  — доверять системному хранилищу ОС (Windows/mac/Linux); подходит для
#             корпоративной сети с прокси/Kaspersky/внутренним CA (рекомендуется)
#   true    — стандартный набор CA (certifi)
#   false   — отключить проверку (только для отладки)
#   <путь>  — путь к своему CA-бандлу (.pem/.cer в формате Base-64)
EVATEAM_VERIFY_SSL=system

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=replace-me

# ---- Расписание ----
# Часовой пояс (IANA), напр. Europe/Moscow
TIMEZONE=Europe/Moscow
# Время утреннего дайджеста, HH:MM
DIGEST_TIME=09:00
# Время ежедневной проверки просроченных задач, HH:MM
DEADLINE_CHECK_TIME=09:30

# ---- Хранилище ----
DB_PATH=data/bot.db
